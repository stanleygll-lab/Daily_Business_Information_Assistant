# ========================================================
# Daily Business Information Assistant - Environment Variables
# 每日行业商业与销售情报助手 - 环境变量配置文件
# ========================================================

# 1. AI 摘要与商机评估模型密钥 (至少配置一个即可开启智能研判)
# Google Gemini API Key (推荐: 速度快、多模态、大并发)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI / DeepSeek / 通义千问 / 本地 Ollama 兼容端点 (可选)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 2. Web 控制台服务参数
PORT=8001
HOST=0.0.0.0
DEBUG=false
